{
  "name": "samvaad-hms-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Samvaad HMS API server \u2014 every /api route plus the data layer, served independently of the Next.js frontend.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed:platform-admin": "node --env-file=.env scripts/seed-platform-admin.mjs",
    "verify:atomicity": "tsx --env-file=.env scripts/verify-atomicity.ts",
    "test:payments": "tsx scripts/test-teleconsult-payments.ts",
    "test:scheduling": "tsx scripts/test-scheduling.ts",
    "test:profile": "tsx scripts/test-profile.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "firebase-admin": "^14.2.0",
    "hono": "^4.7.0",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
