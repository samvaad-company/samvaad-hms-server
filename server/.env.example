# ─── Samvaad HMS API server environment ─────────────────────────────────────
# Copy to `server/.env` and adjust (the server loads it via `--env-file=.env`). With no values set, the app runs against the
# built-in in-memory database (seeded with sample data) — no setup required.

# Data backend: "memory" (default), "supabase", or "mongo".
# Auto-detects "mongo" when MONGODB_URI is set, else "supabase" when
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
DATABASE_DRIVER=memory

# ─── MongoDB (only needed when DATABASE_DRIVER=mongo) ────────────────────────
# Works with a local mongod or MongoDB Atlas. Indexes are created automatically
# on boot, and sample data is seeded once if the database is empty.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB=samvaad_hms
# Set to "false" to skip seeding sample data into an empty database.
MONGODB_AUTO_SEED=true

# ─── Supabase (only needed when DATABASE_DRIVER=supabase) ────────────────────
# 1. Create a Supabase project.
# 2. Run the SQL in supabase/migrations/ (0001 then 0002) in the SQL editor.
# 3. Fill these in. Set SUPABASE_AUTO_SEED=true to load sample data on first boot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_AUTO_SEED=false

# ─── Sessions ───────────────────────────────────────────────────────────────
# A long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE=28800           # 8 hours, in seconds
SESSION_COOKIE_NAME=samvaad_session

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                 # debug | info | warn | error

# ─── Gemini AI (AI Chat assistant + consultation scribe) ─────────────────────
# Powers the platform-wide AI Chat (floating widget + dedicated /chat page)
# AND the appointment scribe's speech-to-text + SOAP brief generation. Leave
# blank to run both in demo mode (canned chat message / deterministic sample
# transcripts) — both UIs work fully with no key.
# Get one at https://aistudio.google.com/apikey
# gemini-3.1-flash-lite is the cheapest current model with function-calling
# support that's still available to newly-created API keys as of Aug 2026 —
# see https://ai.google.dev/gemini-api/docs/pricing for current rates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Server ─────────────────────────────────────────────────────────────────
# Port the API listens on (the frontend's API_URL points here).
PORT=4000
# The public URL of the web app, used when the server must send a browser back
# to it (e.g. after Google sign-in). Optional — behind the frontend proxy it is
# derived from the forwarded host headers.
PUBLIC_APP_URL=

# ─── Firebase Storage (radiology & lab report uploads) ───────────────────────
# Reports are uploaded straight from the browser to Firebase Storage — the
# app never sees the file bytes. Only "Lab Technician", "Lab Partner",
# "Radiology Partner" and "Super Admin" accounts get upload rights; every
# other role gets read-only access. That split is enforced by Firebase
# Storage Security Rules (see storage.rules at the repo root) checking a
# custom claim this server mints — never by the frontend alone, since a
# client-only check can't stop someone from calling the Storage API
# directly. Leave every value below blank and the feature is simply
# unavailable (report upload UI stays hidden) — nothing else breaks.
#
# 1. Firebase Console → Project settings → General → "Your apps" → Web app
#    → SDK setup and configuration → paste the six NEXT_PUBLIC_* values below.
#    These are not secret — they identify the project, not authorize access
#    (Storage Security Rules do that) — but NEXT_PUBLIC_* vars are still
#    bundled into client JS, so only put values here you're fine shipping
#    to the browser.
# (The web app's NEXT_PUBLIC_FIREBASE_* values live in the root .env, not here.)
#
# 2. Firebase Console → Project settings → Service accounts → Generate new
#    private key → downloads a JSON file. This one IS a secret: it lets the
#    server mint sign-in tokens on Firebase's behalf, and is what actually
#    grants/denies upload rights per role. Never expose it to the browser,
#    never commit the JSON file itself — copy three fields from it here:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the "private_key" value verbatim, including "-----BEGIN PRIVATE
# KEY-----"/"-----END PRIVATE KEY-----" and literal \n line breaks, wrapped
# in double quotes exactly as Firebase writes it in the downloaded JSON.
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Tele-consult (paid video consultations) ────────────────────────────────
# The consultation fee and on/off switch live in Admin → Settings (Super Admin
# only) — never in env. Everything below is optional: without it the HMS still
# works, and tele-consults fall back to a mock payment gateway in development.
#
# Shared secret the patient portal's SERVER sends as the `x-portal-key` header
# on /api/portal/* calls. Generate one: openssl rand -hex 32. Keep it off the
# browser and set the same value in the portal's env. Unset → those routes 503.
PORTAL_API_KEY=
#
# Razorpay (online payment). Unset in development → a mock gateway; unset in
# production → paying online is unavailable. Register the webhook
# https://<your-host>/api/razorpay/webhook for the payment.captured event and
# put its secret in RAZORPAY_WEBHOOK_SECRET (different from the key secret). Use a LONG RANDOM value
# (openssl rand -hex 32): anyone who knows it can forge "payment received" calls. Subscribe the webhook to:
# payment.captured, payment.authorized, payment.failed, order.paid, refund.processed.
# Razorpay cannot reach localhost — use your deployed host or a tunnel. Without the webhook, payments are still
# found by the patient's confirmation and a per-minute background check, just up to a minute later.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
#
# Google OAuth client (Cloud Console → APIs & Services → Credentials → Web
# application; enable the Google Calendar API). Add this authorised redirect
# URI: https://<your-host>/api/teleconsult/google/callback. A hospital admin
# then clicks "Connect Google" in Admin → Settings to link the account whose
# calendar the Meet links are created on. Override the redirect only if your
# public host differs from the one the browser uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Timezone for appointment times and Meet events (default Asia/Kolkata).
HOSPITAL_TIMEZONE=
