# ─── Samvaad HMS environment ────────────────────────────────────────────────
# Copy to `.env.local` and adjust. With no values set, the app runs against the
# built-in in-memory database (seeded with sample data) — no setup required.

# Data backend: "memory" (default) or "supabase".
# Auto-detects "supabase" when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set.
DATABASE_DRIVER=memory

# ─── Supabase (only needed when DATABASE_DRIVER=supabase) ────────────────────
# 1. Create a Supabase project.
# 2. Run the SQL in supabase/migrations/ (0001 then 0002) in the SQL editor.
# 3. Fill these in. Set SUPABASE_AUTO_SEED=true to load sample data on first boot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_AUTO_SEED=false

# ─── Sessions ───────────────────────────────────────────────────────────────
# A long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE=28800           # 8 hours, in seconds
SESSION_COOKIE_NAME=samvaad_session

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                 # debug | info | warn | error

# ─── Sarvam AI (consultation scribing) ───────────────────────────────────────
# Speech-to-text + brief generation for the appointment scribe. Leave blank to
# run in mock mode (deterministic sample transcripts) — the feature works with
# no key. Set the key to switch to the live Sarvam API automatically.
# Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Chat model used to turn the transcript into an English SOAP brief.
# Options: sarvam-105b (default, most capable) or sarvam-30b (faster/cheaper).
# Note: the older "sarvam-m" model has been deprecated by Sarvam.
SARVAM_CHAT_MODEL=sarvam-105b
