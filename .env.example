# ─── Samvaad HMS web app (Next.js frontend) environment ─────────────────────
# Copy to `.env.local`. The frontend holds no secrets and no database access:
# every /api request is forwarded to the API server in /server, which has its own
# env file (server/.env — see server/.env.example).

# Where the API server runs. Read when the app is built (next.config.ts), so set
# it in the host's build environment too.
# Local server: http://localhost:4000 — hosted server: https://hmsapi.samvaadai.com
API_URL=http://localhost:4000

# Cookie the API server sets for the session (only needs changing if you changed
# SESSION_COOKIE_NAME on the server).
SESSION_COOKIE_NAME=

# ─── Firebase Storage (radiology & lab report uploads, browser side) ────────
# Reports are uploaded straight from the browser to Firebase Storage. Firebase
# Console → Project settings → General → "Your apps" → Web app → SDK setup and
# configuration. These are not secret (they identify the project; Storage
# Security Rules authorize access) but are bundled into client JS. The matching
# service-account secret lives in server/.env. Leave blank to hide the upload UI.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
