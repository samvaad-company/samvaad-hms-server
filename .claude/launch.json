{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "samvaadhms",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3005,
      "autoPort": true
    },
    {
      "name": "samvaadhms-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_URL=http://localhost:4000",
        "npm",
        "run",
        "dev"
      ],
      "port": 3005,
      "autoPort": true
    },
    {
      "name": "samvaad-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 4000,
      "autoPort": false
    }
  ]
}
